\ lkill ( page idx -- )  remove a leaf cell, freeing its overflow chain
: lkill  cdel ?dup if ovfree then ;

\ lins ( -- )  the pending cell into the leaf at lidx: lput, making room by
\ compaction and then by a split when it refuses
: lins
	depth @ 1 lit - lvl !  tb @ 20 lit + @                   \ page (from the descent)
	begin
		dup lidx @ pb @ lput 0=
	while
		dup pgfreesp lcsz 4 lit + u< if dup pgcmpct then
		dup pgfreesp lcsz 4 lit + u< if lcsz swap lsplit nip then
	repeat drop ;

: put ( txn key klen val vlen -- )
	pvl ! pv ! pkl ! pk ! pt !
	pkl @ 1FF lit u> if "store: key too long" stdie then
	pt @ wtx? 0= if "store: put in a read transaction" stdie then
	pvl @ 400 lit u> dup pov ! if pv @ pvl @ ovwrite ovp ! then
	pt @ root@ 0= if pgnew 1 lit pginit drop pt @ root! then
	pt @ pk @ pkl @ -1 lit descend
	lfound @ if tb @ 20 lit + @ lidx @ lkill then
	lins ;

\ ── append ────────────────────────────────────────────────────────────────────

: apb variable ;      \ a leaf value grown in place (1 KiB)
: append ( txn key klen data n -- )
	pvl ! pv ! pkl ! pk ! pt !
	pkl @ 1FF lit u> if "store: key too long" stdie then
	pt @ wtx? 0= if "store: append in a read transaction" stdie then
	pt @ root@ 0= if pt @ pk @ pkl @ pv @ pvl @ put else
		pt @ pk @ pkl @ -1 lit descend
		lfound @ 0= if pt @ pk @ pkl @ pv @ pvl @ put else
			tb @ 20 lit + @ lidx @ pgcell                                  \ cell
			dup 2 lit + h@ 1 lit and if                                      \ a chain: extend it, repoint the cell
				dup 8 lit + over h@ +                                          \ cell vaddr
				dup @ 2 lit pick 4 lit + @ pv @ pvl @ ovext swap !
				4 lit + dup @ pvl @ + swap !
			else dup 4 lit + @ pvl @ + 400 lit u> 0= if                     \ still a leaf value: rewrite it
				dup 8 lit + over h@ + apb @ 2 lit pick 4 lit + @ mcopy
				pv @ apb @ 2 lit pick 4 lit + @ + pvl @ mcopy
				pt @ pk @ pkl @ apb @ 4 lit pick 4 lit + @ pvl @ + put drop
			else                                                           \ past 1 KiB: a chain of the old bytes, extended
				dup 8 lit + over h@ + over 4 lit + @ ovwrite
				over 4 lit + @ pv @ pvl @ ovext ovp !  -1 lit pov !
				4 lit + @ pvl @ + pvl !
				tb @ 20 lit + @ lidx @ lkill lins
			then then
		then
	then ;

\ ── del ───────────────────────────────────────────────────────────────────────

\ bdel ( page idx -- )  remove a branch cell; the new first key becomes empty
: bdel
	2dup celldel 0= if
		dup 4 lit + @ if 0 lit pgcell 0 lit swap h! else drop then
	else drop then ;

\ lshrink ( -- )  unlink the leaf if it emptied, and so on up; collapse a root
\ branch left with one child
: lshrink
	depth @ 1 lit - lvl !
	begin lvl @ pathpg pgget 4 lit + @ 0=  lvl @ 0 lit u> and while
		lvl @ pathpg pgfree
		lvl @ 1 lit - pathpg pgget lvl @ 1 lit - pathix bdel
		lvl @ 1 lit - lvl !
	repeat
	lvl @ 0= if
		0 lit pathpg pgget dup @ 2 lit = over 4 lit + @ 1 lit = and if
			0 lit pgcell 4 lit + @  0 lit pathpg pgfree  pt @ root!
		else drop then
	then ;

: del ( txn key klen -- flag )
	2 lit pick pt !
	pt @ wtx? 0= if "store: del in a read transaction" stdie then
	pt @ root@ 0= if 2drop drop 0 lit else
		-1 lit descend
		lfound @ if tb @ 20 lit + @ lidx @ lkill lshrink -1 lit else 0 lit then
	then ;

\ ── cursors ───────────────────────────────────────────────────────────────────
\ record: +0 txn (0 = free)  +4 valid  +8 depth  +C path (8 x (pgno, idx))

: cpg  ( cur l -- pgno )  3 lit lshift + C lit + @ ;
: cpg! ( pgno cur l -- )  3 lit lshift + C lit + ! ;
: cix  ( cur l -- idx )   3 lit lshift + 10 lit + @ ;
: cix! ( idx cur l -- )   3 lit lshift + 10 lit + ! ;
: cu variable ;  : cl variable ;  : cok variable ;

: curopen ( txn -- cur )
	0 lit 10 lit 0 lit do
		dup 0= if i 50 lit * st @ 4 lit + @ + dup @ 0= if nip else drop then then
	loop
	dup 0= if "store: no free cursor" stdie then
	tuck !  0 lit over 4 lit + ! ;

: curclose ( cur -- )  0 lit swap ! ;

\ cnext ( cur slots -- flag )  machine code: step to the next key within the
\ current leaf (the usual case); 0 when the leaf is exhausted or not cached
: cnext
83250100 ,   \ lw a1,0(sp)          ( slots )
03254100 ,   \ lw a0,4(sp)          ( cur )
13014100 ,   \ addi sp,sp,4
83228500 ,   \ lw t0,8(a0)
