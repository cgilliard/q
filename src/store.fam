\ ──────────────────────────────────────────────────────────────────────────────
\ src/store.fam — the key-value store: a copy-on-write B+tree on src/pager.fam
\ with LMDB-shaped transactions.  One key space; namespaces are key prefixes.
\
\   stinit   ( -- )                        once, after pgopen
\   txbeg    ( write? -- txn )             a transaction: readers see the last
\                                          commit and are never blocked; one
\                                          writer at a time
\   txcommit ( txn -- )   txabort ( txn -- )
\   get      ( txn key klen buf cap -- vlen | -1 )   copy the value (at most
\                                          cap bytes) and return its length
\   getat    ( txn key klen off buf cap -- vlen | -1 )   the same from byte
\                                          off of the value (nothing copied
\                                          past its end)
\   put      ( txn key klen val vlen -- )  insert or replace
\   append   ( txn key klen data n -- )    add n bytes to the end of the value
\                                          (a put when there is none)
\   del      ( txn key klen -- flag )      -1 if it was there
\   curopen  ( txn -- cur )   curclose ( cur -- )
\   curfirst ( cur -- flag )               the smallest key; 0 = empty tree
\   curseek  ( cur key klen -- flag )      the first key >= key; -1 = exact
\   curnext  ( cur -- flag )               0 = past the end
\   curkey   ( cur buf cap -- klen | -1 )  curval ( cur buf cap -- vlen | -1 )
\
\ Keys are byte strings up to 511 bytes, ordered bytewise then by length.
\ Values up to 1 KiB live in the leaf; larger ones go to a chain of overflow
\ pages (4 bytes link + 4088 payload each) and the leaf keeps a 4-byte
\ reference, so the leaf fanout never collapses.  The chain is linked from its
\ END: the leaf names the last page and each page names the one before it,
\ so an append copies the tail page, adds pages after it and repoints the
\ leaf, whatever the value's length; a read walks back from the end, filling
\ the buffer from its tail.  The pager's cache bounds a
\ transaction (see src/pager.fam): 512 dirty pages in all, 16 per set.
\
\ Page: +0 type (1 leaf, 2 branch, 3 overflow)  +4 nkeys  +8 upper (the cell
\ area grows down from 4096)  +16 slot[i] = page offset of cell i, in key
\ order.  Leaf cell: +0 klen(16) +2 flags(16: bit0 overflow) +4 vlen +8 key,
\ then the value bytes or the overflow page number.  Branch cell: +0 klen +4
\ child +8 key; cell 0's key is empty, so child i holds keys >= key i and
\ < key i+1.  Cells are 4-byte multiples; a deleted cell's bytes stay until the
\ page is compacted (when an insert needs the room).
\
\ A read walks the tree in one machine-code routine (tdesc: cache lookup,
\ search and child step per level), falling back to the pager only to load a
\ missing page; a write does the same walk and then copies what is not yet its
\ own.  The leaf insert and delete (lput, cdel) and the cursor's step within a
\ leaf (cnext, ccell) and the value copies are machine code too; splits and
\ merges stay in fam.
\ A put copies the root-to-leaf path once per transaction (pgcow), splits a
\ full leaf in half and pushes the separator up, splitting branches as needed.
\ An append rewrites a leaf value in place (moving it to a chain once it
\ passes 1 KiB) and extends a chain as above.
\ A del removes the cell; an emptied leaf is unlinked and a root with one child
\ collapses.  Underfull pages are not merged (space returns when they empty).
\
\ Cursors hold page numbers and indices per level, never addresses.  In a
\ write transaction a cursor is valid until the next put or del.  The store is
\ called from one thread (the loop); its scratch state is global.  One read
\ transaction per thread at a time.  Needs src/pager.fam (and what it needs).
\ ──────────────────────────────────────────────────────────────────────────────

: st variable ;      \ +0 txns(16 x 16)  +4 cursors(16 x 0x50)  +8 scratch page
                     \ +C path(8 x 16: pgno, idx, slot)  +10 key scratch (512)

: stdie ( msg -- )  pgdie ;

: umin ( a b -- min )  2dup u> if swap then drop ;
: umax ( a b -- max )  2dup u< if swap then drop ;

\ ── pages ─────────────────────────────────────────────────────────────────────

\ pgsearch ( page key klen -- idx found )  binary search of a page's cells:
\ idx is the first cell with key >= the search key (nkeys if none), found is
\ -1 when cell idx's key is equal.  Machine code: the per-level cost of a get.
: pgsearch
03260100 ,   \ lw a2,0(sp)          ( klen )
83254100 ,   \ lw a1,4(sp)          ( key )
03258100 ,   \ lw a0,8(sp)          ( page )
13014100 ,   \ addi sp,sp,4         ( results: idx at 4(sp), found at 0(sp) )
93020000 ,   \ li t0,0              ( lo )
03234500 ,   \ lw t1,4(a0)          ( hi = nkeys )
63F46208 ,   \ loop: bgeu t0,t1,none
B3836200 ,   \ add t2,t0,t1
93D31300 ,   \ srli t2,t2,0x1       ( mid )
139E2300 ,   \ slli t3,t2,0x2
330EAE00 ,   \ add t3,t3,a0
032E0E01 ,   \ lw t3,16(t3)         ( slot[mid] )
330EAE00 ,   \ add t3,t3,a0         ( cell )
835F0E00 ,   \ lhu t6,0(t3)         ( cl = cell klen )
930E8E00 ,   \ addi t4,t3,8         ( ck = cell key )
138F0F00 ,   \ mv t5,t6
6364CF00 ,   \ bltu t5,a2,cmp       ( n = min(cl, klen) )
130F0600 ,   \ mv t5,a2
93860E00 ,   \ cmp: mv a3,t4
13870500 ,   \ mv a4,a1
93070F00 ,   \ mv a5,t5
63820702 ,   \ byte: beqz a5,len
03C80600 ,   \ lbu a6,0(a3)
83480700 ,   \ lbu a7,0(a4)
63681803 ,   \ bltu a6,a7,right
63EA0803 ,   \ bltu a7,a6,left
93861600 ,   \ addi a3,a3,1
13071700 ,   \ addi a4,a4,1
9387F7FF ,   \ addi a5,a5,-1
6FF01FFE ,   \ j byte
63ECCF00 ,   \ len: bltu t6,a2,right
636EF601 ,   \ bltu a2,t6,left
23227100 ,   \ sw t2,4(sp)          ( equal: idx = mid )
130EF0FF ,   \ li t3,-1
2320C101 ,   \ sw t3,0(sp)          ( found )
6F00C001 ,   \ j done
93821300 ,   \ right: addi t0,t2,1  ( lo = mid + 1 )
6FF05FF8 ,   \ j loop
13830300 ,   \ left: mv t1,t2       ( hi = mid )
6FF0DFF7 ,   \ j loop
23225100 ,   \ none: sw t0,4(sp)    ( idx = lo )
23200100 ,   \ sw zero,0(sp)
;            \ done:

: pgfreesp ( page -- n )  dup 8 lit + @ swap 4 lit + @ 2 lit lshift - 10 lit - ;
: pgcell   ( page i -- cell )  2 lit lshift over + 10 lit + @ + ;
: lcellsz  ( cell -- n )
	dup h@ over 2 lit + h@ 1 lit and if 4 lit else over 4 lit + @ then
	+ 8 lit + 3 lit + FFFFFFFC lit and nip ;
: bcellsz  ( cell -- n )  h@ 8 lit + 3 lit + FFFFFFFC lit and ;
: cellsz   ( page cell -- n )  swap @ 1 lit = if lcellsz else bcellsz then ;

\ cellins ( page idx size -- cell )  open slot idx and carve size bytes
: cellins
	2 lit pick 8 lit + @ swap -                      \ page idx upper'
	2 lit pick 4 lit + @                             \ page idx upper' n
	begin dup 3 lit pick u> while                    \ slot[n] = slot[n-1] down to idx
		dup 2 lit lshift 4 lit pick + 10 lit +
		dup 4 lit - @ swap !
		1 lit -
	repeat drop
	over 2 lit lshift 3 lit pick + 10 lit + over swap !   \ slot[idx] = upper'
	dup 3 lit pick 8 lit + !                         \ upper = upper'
	2 lit pick 4 lit + dup @ 1 lit + swap !          \ nkeys++
	nip + ;

\ celldel ( page idx -- )  close slot idx (the cell's bytes stay)
: celldel
	over 4 lit + @ 1 lit -                           \ page idx last
	begin 2dup swap u> while
		over 2 lit lshift 3 lit pick + 10 lit +
		dup 4 lit + @ swap !
		swap 1 lit + swap
	repeat
	2drop
	4 lit + dup @ 1 lit - swap ! ;

\ pgcmpa ( page scratch -- )  rebuild the page without its dead cells, via the
\ scratch page: machine code (the fam version cost 127 us per call, and a
\ replace-heavy leaf compacts every few dozen puts)
: pgcmpa
83250100 ,   \ lw a1,0(sp)
03254100 ,   \ lw a0,4(sp)
13018100 ,   \ addi sp,sp,8
83220500 ,   \ lw t0,0(a0)
23A05500 ,   \ sw t0,0(a1)
83224500 ,   \ lw t0,4(a0)
23A25500 ,   \ sw t0,4(a1)
8322C500 ,   \ lw t0,12(a0)
23A65500 ,   \ sw t0,12(a1)
03230500 ,   \ lw t1,0(a0)
83234500 ,   \ lw t2,4(a0)
371E0000 ,   \ lui t3,0x1
930E0000 ,   \ li t4,0
63F07E08 ,   \ bgeu t4,t2,b4 <.L7^B1>
139F2E00 ,   \ slli t5,t4,0x2
330FAF00 ,   \ add t5,t5,a0
032F0F01 ,   \ lw t5,16(t5)
330FAF00 ,   \ add t5,t5,a0
835F0F00 ,   \ lhu t6,0(t5)
13061000 ,   \ li a2,1
6310C302 ,   \ bne t1,a2,70 <.L4^B1>
83562F00 ,   \ lhu a3,2(t5)
93F61600 ,   \ andi a3,a3,1
63860600 ,   \ beqz a3,68 <.L2^B1>
938F4F00 ,   \ addi t6,t6,4
6F00C000 ,   \ j 70 <.L4^B1>
83264F00 ,   \ lw a3,4(t5)
B38FDF00 ,   \ add t6,t6,a3
938FBF00 ,   \ addi t6,t6,11
93FFCFFF ,   \ andi t6,t6,-4
330EFE41 ,   \ sub t3,t3,t6
3386C501 ,   \ add a2,a1,t3
93962E00 ,   \ slli a3,t4,0x2
B386B600 ,   \ add a3,a3,a1
23A8C601 ,   \ sw t3,16(a3)
93860F00 ,   \ mv a3,t6
638E0600 ,   \ beqz a3,ac <.L6^B1>
03270F00 ,   \ lw a4,0(t5)
2320E600 ,   \ sw a4,0(a2)
130F4F00 ,   \ addi t5,t5,4
13064600 ,   \ addi a2,a2,4
9386C6FF ,   \ addi a3,a3,-4
6FF09FFE ,   \ j 90 <.L5^B1>
938E1E00 ,   \ addi t4,t4,1
6FF05FF8 ,   \ j 34 <.L1^B1>
23A4C501 ,   \ sw t3,8(a1)
938E0500 ,   \ mv t4,a1
130F0500 ,   \ mv t5,a0
B71F0000 ,   \ lui t6,0x1
03A60E00 ,   \ lw a2,0(t4)
2320CF00 ,   \ sw a2,0(t5)
938E4E00 ,   \ addi t4,t4,4
130F4F00 ,   \ addi t5,t5,4
938FCFFF ,   \ addi t6,t6,-4 # ffc <.L8^B1+0xf38>
E3960FFE ,   \ bnez t6,c4 <.L8^B1>
;

: pgcmpct ( page -- )  st @ 8 lit + @ pgcmpa ;

\ pginit ( pgno addr type -- pgno addr )  a fresh tree page
: pginit  over !  0 lit over 4 lit + !  1000 lit over 8 lit + ! ;

\ ── overflow chains ───────────────────────────────────────────────────────────

: pb variable ;      \ the put parameters: +0 key +4 klen +8 val +C vlen +10 ovf +14 overflow page
: ovp pb @ 14 lit + ;
: owv variable ;  : owc variable ;  : owp variable ;  : owf variable ;
: orb variable ;  : orc variable ;

: ovwrite ( val vlen -- last )
	owc ! owv !  0 lit owp !
	begin
		pgnew 3 lit pginit                           \ pgno addr
		owp @ over 4 lit + !                         \ link: the page before (0 for the first)
		owv @ over 8 lit + owc @ FF8 lit umin mcopy
		owc @ FF8 lit umin dup owv @ + owv !  owc @ swap - owc !
		drop owp !
		owc @ 0=
	until
	owp @ ;

\ ovext ( last vlen data n -- last' )  n more bytes after a chain's vlen: the
\ tail page copied (pgcow: itself when made in this transaction) and filled,
\ then new pages
: owt variable ;  : owa variable ;
: ovext
	owc ! owv !
	FF8 lit % ?dup 0= if FF8 lit then owt !      \ bytes in the tail page
	pgcow owa ! owp !
	begin owc @ while
		owt @ FF8 lit = if
			pgnew 3 lit pginit  owp @ over 4 lit + !  owa ! owp !  0 lit owt !
		then
		owv @ owa @ 8 lit + owt @ +  owc @ FF8 lit owt @ - umin  mcopy
		owc @ FF8 lit owt @ - umin  dup owv @ + owv !  dup owt @ + owt !  owc @ swap - owc !
	repeat
	owp @ ;

\ ovread ( vlen last buf cap off -- )  bytes off..off+cap of a chain of vlen
: orl variable ;  : oro variable ;  : ors variable ;  : olo variable ;  : ohi variable ;
: ovread
	ors ! orc ! orb !
	begin over while                              \ pos pgno
		over FF8 lit % ?dup 0= if FF8 lit then orl !
		over orl @ - oro !
		oro @ ors @ umax olo !  oro @ orl @ + ors @ orc @ + umin ohi !
		olo @ ohi @ u< if dup pgget 8 lit + olo @ oro @ - +  orb @ olo @ ors @ - +  ohi @ olo @ -  mcopy then
		pgget 4 lit + @ swap drop oro @ swap
	repeat 2drop ;

: ovfree ( pgno -- )  begin ?dup while dup pgget 4 lit + @ swap pgfree repeat ;

\ ── transactions ──────────────────────────────────────────────────────────────

: root@ ( txn -- root )  4 lit + @ ;
: root! ( root txn -- )  4 lit + ! ;
: wtx?  ( txn -- flag )  @ 2 lit = ;

: txfree ( -- txn )
	0 lit 10 lit 0 lit do
		dup 0= if i 4 lit lshift st @ @ + dup @ 0= if nip else drop then then
	loop
	dup 0= if "store: no free transaction record" stdie then ;

: txbeg ( write? -- txn )
	txfree swap if
		pgwtx if "store: a write transaction is already open" stdie then
		pgwbeg 2 lit over !  pgroot over root!
	else
		pgrbeg over root!  1 lit over !
	then ;

: txcommit ( txn -- )
	dup wtx? if dup root@ pgcommit else pgrend then 0 lit swap ! ;
: txabort ( txn -- )
	dup wtx? if pgabort else pgrend then 0 lit swap ! ;

\ ── the path: root to leaf, one (pgno, idx) per level ─────────────────────────

: depth variable ;   : lidx variable ;   : lfound variable ;
: pathpg  ( i -- pgno )   4 lit lshift st @ C lit + @ + @ ;
: pathpg! ( pgno i -- )   4 lit lshift st @ C lit + @ + ! ;
: pathix  ( i -- idx )    4 lit lshift st @ C lit + @ + 4 lit + @ ;
: pathix! ( idx i -- )    4 lit lshift st @ C lit + @ + 4 lit + ! ;
: pathsl  ( i -- slot )   4 lit lshift st @ C lit + @ + 8 lit + @ ;
: leafpg  ( -- pgno )     depth @ 1 lit - pathpg ;

\ ── the read descent, machine code ────────────────────────────────────────────
\ tdesc ( tb -- )  walk from tb.pgno to the leaf for tb.key: at each level look
\ the page up in its cache set (stamping it), binary-search it, record
\ (pgno, idx) in the path, and step to the child.  Ends with found = -1 (key at
\ idx), 0 (not there, idx = insertion point) and the leaf's address, or
\ found = 1 when a page is not cached: tb.pgno is that page, and the caller
\ loads it and starts over.  Block tb: +00 key +04 klen +08 pgno +0C idx
\ +10 found +14 depth +18 cache slots +1C path +20 leaf addr +24 &stamp tick
\ +28 &depth +2C &lidx +30 &lfound: the fam variables, written directly at the
\ leaf so no fam glue copies them out.
\ A path entry is 16 bytes: pgno, idx, the cache slot the page was found in
\ (a hint for the copy-on-write pass; it may have been evicted since), pad.
: tdesc
03250100 ,   \ lw a0,0(sp)
13014100 ,   \ addi sp,sp,4
83268500 ,   \ lw a3,8(a0)
232A0500 ,   \ sw zero,20(a0)
03278501 ,   \ lw a4,24(a0)
93F7F601 ,   \ andi a5,a3,31
93978700 ,   \ slli a5,a5,0x8
3307F700 ,   \ add a4,a4,a5
93070710 ,   \ addi a5,a4,256
03280700 ,   \ lw a6,0(a4)
630ED800 ,   \ beq a6,a3,44 <.L12^B1>
13070701 ,   \ addi a4,a4,16
E36AF7FE ,   \ bltu a4,a5,24 <.L11^B1>
2324D500 ,   \ sw a3,8(a0)
13081000 ,   \ li a6,1
23280501 ,   \ sw a6,16(a0)
6F008015 ,   \ j 198 <.L19^B1>
83274502 ,   \ lw a5,36(a0)
03A80700 ,   \ lw a6,0(a5)
13081800 ,   \ addi a6,a6,1
23A00701 ,   \ sw a6,0(a5)
23260701 ,   \ sw a6,12(a4)
83274501 ,   \ lw a5,20(a0)
93974700 ,   \ slli a5,a5,0x4
0328C501 ,   \ lw a6,28(a0)
B3870701 ,   \ add a5,a5,a6
23A0D700 ,   \ sw a3,0(a5)
23A4E700 ,   \ sw a4,8(a5)
03278700 ,   \ lw a4,8(a4)
83250500 ,   \ lw a1,0(a0)
03264500 ,   \ lw a2,4(a0)
93020000 ,   \ li t0,0
03234700 ,   \ lw t1,4(a4)
63F06208 ,   \ bgeu t0,t1,104 <.L17^B1>
B3836200 ,   \ add t2,t0,t1
93D31300 ,   \ srli t2,t2,0x1
139E2300 ,   \ slli t3,t2,0x2
330EEE00 ,   \ add t3,t3,a4
032E0E01 ,   \ lw t3,16(t3)
330EEE00 ,   \ add t3,t3,a4
835F0E00 ,   \ lhu t6,0(t3)
930E8E00 ,   \ addi t4,t3,8
138F0F00 ,   \ mv t5,t6
6364CF00 ,   \ bltu t5,a2,b4 <.L1^B1>
130F0600 ,   \ mv t5,a2
13880E00 ,   \ mv a6,t4
93880500 ,   \ mv a7,a1
63020F02 ,   \ beqz t5,e0 <.L5^B1>
034E0800 ,   \ lbu t3,0(a6)
83CE0800 ,   \ lbu t4,0(a7)
6366DE03 ,   \ bltu t3,t4,f4 <.L15^B1>
63E8CE03 ,   \ bltu t4,t3,fc <.L16^B1>
13081800 ,   \ addi a6,a6,1
93881800 ,   \ addi a7,a7,1
130FFFFF ,   \ addi t5,t5,-1
6FF01FFE ,   \ j bc <.L2^B1>
63EACF00 ,   \ bltu t6,a2,f4 <.L15^B1>
636CF601 ,   \ bltu a2,t6,fc <.L16^B1>
93820300 ,   \ mv t0,t2
1303F0FF ,   \ li t1,-1
6F008001 ,   \ j 108 <.L18^B1>
93821300 ,   \ addi t0,t2,1
6FF0DFF8 ,   \ j 84 <.L13^B1>
13830300 ,   \ mv t1,t2
6FF05FF8 ,   \ j 84 <.L13^B1>
13030000 ,   \ li t1,0
83270700 ,   \ lw a5,0(a4)
13081000 ,   \ li a6,1
63960705 ,   \ bne a5,a6,15c <.L14^B1>
83274501 ,   \ lw a5,20(a0)
13984700 ,   \ slli a6,a5,0x4
8328C501 ,   \ lw a7,28(a0)
33081801 ,   \ add a6,a6,a7
23225800 ,   \ sw t0,4(a6)
93871700 ,   \ addi a5,a5,1
232AF500 ,   \ sw a5,20(a0)
2324D500 ,   \ sw a3,8(a0)
23265500 ,   \ sw t0,12(a0)
23286500 ,   \ sw t1,16(a0)
2320E502 ,   \ sw a4,32(a0)
03288502 ,   \ lw a6,40(a0)
2320F800 ,   \ sw a5,0(a6)
0328C502 ,   \ lw a6,44(a0)
23205800 ,   \ sw t0,0(a6)
03280503 ,   \ lw a6,48(a0)
23206800 ,   \ sw t1,0(a6)
6F000004 ,   \ j 198 <.L19^B1>
63140300 ,   \ bnez t1,164 <.L3^B1>
9382F2FF ,   \ addi t0,t0,-1
83274501 ,   \ lw a5,20(a0)
13984700 ,   \ slli a6,a5,0x4
8328C501 ,   \ lw a7,28(a0)
33081801 ,   \ add a6,a6,a7
23225800 ,   \ sw t0,4(a6)
93871700 ,   \ addi a5,a5,1
232AF500 ,   \ sw a5,20(a0)
13982200 ,   \ slli a6,t0,0x2
3308E800 ,   \ add a6,a6,a4
03280801 ,   \ lw a6,16(a6)
3308E800 ,   \ add a6,a6,a4
83264800 ,   \ lw a3,4(a6)
6FF0DFE7 ,   \ j 10 <.L10^B1>
;            \ done:

: tb variable ;  : droot variable ;
\ rdesc ( root key klen -- )  the read descent: tdesc, loading each page it
\ finds missing and starting over, then depth/lidx/lfound as descend leaves them
: rdesc
	tb @ 4 lit + !  tb @ !  dup droot !  tb @ 8 lit + !
	tb @ tdesc
	tb @ 10 lit + @ 1 lit = if                               \ a page to load: rare
		begin
			tb @ 8 lit + @ pgget drop  droot @ tb @ 8 lit + !  tb @ tdesc
			tb @ 10 lit + @ 1 lit = 0=
		until
	then ;

: dk variable ;  : dkl variable ;  : dcow variable ;
\ descend ( txn key klen cow? -- )  fill the path for key; with cow?, copy every
\ page on it (pgcow) and point each parent at its copy.  Leaves lidx/lfound.
\ A read goes through rdesc (machine code); the copying walk stays in fam.
: wdesc ( txn -- )
	dup root@ dk @ dkl @ rdesc                               \ txn   (the path, no copying)
	\ a page is only ever ours if its parent is: when the leaf is, the whole path is
	depth @ 1 lit - dup pathsl dup @ rot pathpg = swap 4 lit + @ 2 lit and and if drop else
		depth @ 0 lit do
			i pathpg i pathsl                                \ txn pgno slot
			dup @ 2 lit pick = over 4 lit + @ 2 lit and and 0= if   \ not already ours
				drop pgcow                                   \ txn pgno' addr'
				i depth @ 1 lit - = if tb @ 20 lit + ! else drop then   \ the leaf's new address
				dup i pathpg!
				i 0= if over root!
				else i 1 lit - pathpg pgget i 1 lit - pathix pgcell 4 lit + ! then
			else 2drop then
		loop drop
	then ;

: descend
	dcow ! dkl ! dk !
	dcow @ 0= if root@ dk @ dkl @ rdesc else wdesc then ;



\ ── get ───────────────────────────────────────────────────────────────────────

: gbuf variable ;  : gcap variable ;  : goff variable ;

\ lcopya ( cell buf cap -- vlen | -2 )  machine code: an inline value into buf
\ (at most cap bytes); -2 for an overflow value (lcopy handles those)
: lcopya
83260100 ,   \ lw a3,0(sp)
03264100 ,   \ lw a2,4(sp)
032F8100 ,   \ lw t5,8(sp)
13018100 ,   \ addi sp,sp,8
83520F00 ,   \ lhu t0,0(t5)
03532F00 ,   \ lhu t1,2(t5)
13731300 ,   \ andi t1,t1,1
63080300 ,   \ beqz t1,2c <.L3^B1>
9302E0FF ,   \ li t0,-2
23205100 ,   \ sw t0,0(sp)
6F00C003 ,   \ j 64 <.L9^B1>
83234F00 ,   \ lw t2,4(t5)
930E8F00 ,   \ addi t4,t5,8
B38E5E00 ,   \ add t4,t4,t0
138E0300 ,   \ mv t3,t2
6364DE00 ,   \ bltu t3,a3,44 <.L4^B1>
138E0600 ,   \ mv t3,a3
630E0E00 ,   \ beqz t3,60 <.L5^B1>
83CF0E00 ,   \ lbu t6,0(t4)
2300F601 ,   \ sb t6,0(a2)
938E1E00 ,   \ addi t4,t4,1
13061600 ,   \ addi a2,a2,1
130EFEFF ,   \ addi t3,t3,-1
6FF09FFE ,   \ j 44 <.L4^B1>
23207100 ,   \ sw t2,0(sp)
;

\ lcopy ( cell -- vlen )  the cell's value from byte goff into gbuf (at most gcap bytes)
: lcopy
	dup 4 lit + @ swap                                       \ vlen cell
	dup 8 lit + over h@ +                                    \ vlen cell vaddr
	swap 2 lit + h@ 1 lit and if
		ovp 4 lit mcopy  dup ovp @ gbuf @ gcap @ goff @ ovread
	else
		goff @ + gbuf @ 2 lit pick goff @ - dup 0< if drop 0 lit then gcap @ umin mcopy
	then ;

: get ( txn key klen buf cap -- vlen|-1 )
	gcap ! gbuf !  0 lit goff !
	rot root@ ?dup 0= if 2drop -1 lit else
		-rot rdesc
		lfound @ if
			tb @ 20 lit + @ lidx @ pgcell dup gbuf @ gcap @ lcopya dup -2 lit = if drop lcopy else nip then
		else -1 lit then
	then ;

: getat ( txn key klen off buf cap -- vlen|-1 )
	gcap ! gbuf ! goff !
	rot root@ ?dup 0= if 2drop -1 lit else
		-rot rdesc
		lfound @ if tb @ 20 lit + @ lidx @ pgcell lcopy else -1 lit then
	then ;

\ ── put ───────────────────────────────────────────────────────────────────────

: pt variable ;
: pk pb @ ;  : pkl pb @ 4 lit + ;  : pv pb @ 8 lit + ;  : pvl pb @ C lit + ;  : pov pb @ 10 lit + ;
: bk variable ;  : bkl variable ;  : bc variable ;  : blv variable ;  : bpg variable ;  : bsz variable ;
: bsa variable ;  : bsn variable ;  : bsh variable ;  : bskl variable ;
: lsp variable ;  : lsn variable ;  : lsa variable ;  : lsh variable ;  : lvl variable ;

: bcell! ( cell -- )  bkl @ over h!  bc @ over 4 lit + !  bk @ swap 8 lit + bkl @ mcopy ;

\ newroot ( -- )  the root split: a branch over the old root and bsn
: newroot
	pgnew 2 lit pginit                                       \ pgno addr
	dup 0 lit 8 lit cellins 0 lit over h! pt @ root@ swap 4 lit + !
	dup 1 lit bsz @ cellins bcell!
	drop pt @ root! ;

\ bsplit ( -- )  halve the branch bpg: the right half moves to a new branch,
\ the pending cell (bk/bc) goes to its side, and the right half's first key
\ is promoted: it becomes the pending cell for the level above.
: bsplit
	pgnew 2 lit pginit bsa ! bsn !
	bpg @ 4 lit + @ 1 lit rshift bsh !
	bpg @ bsh @ pgcell h@ bskl !
	bpg @ 4 lit + @ bsh @ do
		bpg @ i pgcell dup bcellsz                           \ cell sz
		bsa @ i bsh @ - 2 lit pick cellins swap mcopy
	loop
	bsh @ bpg @ 4 lit + !  bpg @ pgcmpct
	blv @ pathix 1 lit + dup bsh @ u> if bsh @ - bsa @ swap else bpg @ swap then
	bsz @ cellins bcell!
	bsa @ 0 lit pgcell dup 8 lit + st @ 10 lit + @ bskl @ mcopy  0 lit swap h!
	st @ 10 lit + @ bk !  bskl @ bkl !  bsn @ bc !  blv @ 1 lit - blv ! ;

\ brins ( key klen child lvl -- )  insert a separator after the path's child at
\ level lvl, splitting the branch when full and carrying the promoted key up;
\ level -1 is a new root
: brins
	blv ! bc ! bkl ! bk !
	begin
		bkl @ 8 lit + 3 lit + FFFFFFFC lit and bsz !
		blv @ 0< if newroot -1 lit else
			blv @ pathpg pgget bpg !
			bpg @ pgfreesp bsz @ 4 lit + u< if bpg @ pgcmpct then          \ the cell and its slot
			bpg @ pgfreesp bsz @ 4 lit + u< if bsplit 0 lit else
				bpg @ blv @ pathix 1 lit + bsz @ cellins bcell! -1 lit
			then
		then
	until ;

: lcsz ( -- size )  pkl @ 8 lit + pov @ if 4 lit else pvl @ then + 3 lit + FFFFFFFC lit and ;

\ lsplit ( size page -- size page' )  halve the leaf; page' is the half the
\ pending key belongs to, lidx its index there; the separator goes up
: lsplit
	lsp !
	pgnew 1 lit pginit lsa ! lsn !
	lsp @ 4 lit + @ 1 lit rshift lsh !
	lsp @ 4 lit + @ lsh @ do
		lsp @ i pgcell dup lcellsz
		lsa @ i lsh @ - 2 lit pick cellins swap mcopy
	loop
	lsh @ lsp @ 4 lit + !  lsp @ pgcmpct
	lsa @ 0 lit pgcell dup 8 lit + swap h@ lsn @ lvl @ 1 lit - brins
	lidx @ lsh @ u> if lidx @ lsh @ - lidx ! lsa @ else lsp @ then ;

\ cdel ( page idx -- ovfpg|0 )  celldel in machine code for the leaf hot path;
\ returns the removed cell's overflow page (0 if its value was inline) so the
\ caller can free the chain
: cdel
83250100 ,   \ lw a1,0(sp)
03254100 ,   \ lw a0,4(sp)
13014100 ,   \ addi sp,sp,4
93922500 ,   \ slli t0,a1,0x2
B382A200 ,   \ add t0,t0,a0
83A20201 ,   \ lw t0,16(t0)
B382A200 ,   \ add t0,t0,a0
03D32200 ,   \ lhu t1,2(t0)
