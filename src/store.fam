131E8E01 ,   \ slli t3,t3,0x18
3363C301 ,   \ or t1,t1,t3
6F008000 ,   \ j 64 <.L3^B1>
13030000 ,   \ li t1,0
23206100 ,   \ sw t1,0(sp)
83224500 ,   \ lw t0,4(a0)
9382F2FF ,   \ addi t0,t0,-1
63FE5500 ,   \ bgeu a1,t0,8c <.L5^B1>
93932500 ,   \ slli t2,a1,0x2
B383A300 ,   \ add t2,t2,a0
03AE4301 ,   \ lw t3,20(t2)
23A8C301 ,   \ sw t3,16(t2)
93851500 ,   \ addi a1,a1,1
6FF09FFE ,   \ j 70 <.L4^B1>
23225500 ,   \ sw t0,4(a0)
;

\ cdelx ( page idx -- )  the old form, for the tests and probes
: cdelx cdel drop ;


\ lput ( page idx pb -- flag )  the leaf insert in machine code: the cell for
\ the parameters in pb (key, klen, val, vlen, ovf; the overflow page number
\ stands in for the value bytes when ovf is set) at slot idx; 0 when the page
\ lacks room for the cell and its slot
: lput
