1353C300 ,   \ srli t1,t1,0xc
9313C300 ,   \ slli t2,t1,0xc
B3837240 ,   \ sub t2,t0,t2
371E0000 ,   \ lui t3,0x1
130EFEFF ,   \ addi t3,t3,-1 # fff <.text+0xfff>
B3F3C301 ,   \ and t2,t2,t3
931EC300 ,   \ slli t4,t1,0xc
93EE7E33 ,   \ ori t4,t4,823
23A0D101 ,   \ sw t4,0(gp)
93814100 ,   \ addi gp,gp,4
939E4301 ,   \ slli t4,t2,0x14
370F0300 ,   \ lui t5,0x30
130F3F31 ,   \ addi t5,t5,787 # 30313 <.text+0x30313>
B3EEEE01 ,   \ or t4,t4,t5
23A0D101 ,   \ sw t4,0(gp)
93814100 ,   \ addi gp,gp,4
B70EC1FF ,   \ lui t4,0xffc10
938E3E11 ,   \ addi t4,t4,275 # ffc10113 <.text+0xffc10113>
23A0D101 ,   \ sw t4,0(gp)
93814100 ,   \ addi gp,gp,4
B72E6100 ,   \ lui t4,0x612
938E3E02 ,   \ addi t4,t4,35 # 612023 <.text+0x612023>
23A0D101 ,   \ sw t4,0(gp)
93814100 ,   \ addi gp,gp,4
;

\ code{ ... }code  — jump over a block; afterwards push the block's address.
\ cstack while open: [bodyaddr patchaddr].
:I code{  here ,j0 here cswap ;
:I }code  jpat! ,addr ;

\ ,texit  ( C: -- )  emit `li a7,1 ; ecall` — the exit syscall, inline.
:M ,texit
B7121000 ,   \ lui t0,0x101
93823289 ,   \ addi t0,t0,-1901 # 100893 <.text+0x100893>
23A05100 ,   \ sw t0,0(gp)
93814100 ,   \ addi gp,gp,4
93023007 ,   \ li t0,115
23A05100 ,   \ sw t0,0(gp)
93814100 ,   \ addi gp,gp,4
;

\ thread{ ... }thread — the same, with the exit syscall appended to the body.
:I thread{  here ,j0 here cswap ;
:I }thread  ,texit jpat! ,addr ;

