\ ── kernel data ───────────────────────────────────────────────────────────────

: kblk variable ;
: K   kblk @ ;                  \ ( -- K )
: cur K @ ;                     \ ( -- tcb )  the thread that trapped
: ktab K 8 lit + @ ;            \ ( -- table )
: tcb ( i -- tcb )  A0 lit * ktab + ;

\ the trapped thread's data stack: read args, write results
: usp   cur 8 lit + @ ;                       \ ( -- sp )
: upop  usp dup @ swap 4 lit + cur 8 lit + ! ; \ ( -- x )
: upush usp 4 lit - dup cur 8 lit + ! ! ;     \ ( x -- )

\ ── table walks (asm) ─────────────────────────────────────────────────────────

