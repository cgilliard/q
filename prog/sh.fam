\ prog/sh.fam — a shell on the console.  A line at a time from handle "0",
\ echoed as it is typed (Backspace, Ctrl-U erases the line, Ctrl-C abandons it,
\ Up and Down recall the last 16 lines, Ctrl-D on an empty line exits): pwd, cd [DIR], ls [DIR], exit (on the
\ console the node halts; in a terminal the shell ends and its window closes), the store's
\ commands (set, get, add, del, list: lib/pkv.fam), or a program's name, which
\ is exec'd (bin/NAME, or the path itself when the name has a slash: ./t.bin,
\ ../bin/x, /bin/x) with the line as its arguments and waited for; "> KEY"
\ sends its output to KEY, ">> KEY" adds to it, "< KEY" is its input.  The working directory is the kernel's
\ "." (lib/sys.fam spwd/scd): the shell resolves ".", ".." and relative names
\ against it, the kernel only joins.  ls lists one level: a name with "/" after
\ it has more beneath, and the walk skips what is beneath by seeking past it;
\ a directory's marker (mkdir's DIR/) is not an entry.
\ Its output goes through handle 0, so it can be redirected like a program's.
: lbuf variable ;  : llen variable ;  : ldone variable ;          \ the line
: rbuf variable ;  : rpos variable ;  : rlen variable ;           \ what the console gave
: obuf variable ;  : cbuf variable ;                              \ answers and scans; a byte
: pbuf variable ;  : plen variable ;                              \ a path being built
: sbuf variable ;  : sln variable ;                               \ a scan's start key
: ca variable ;  : ce variable ;  : cs variable ;                 \ a path's cursor, end, component
: lsl variable ;  : lsk variable ;  : lskl variable ;  : lsi variable ;  : lsgo variable ;

: emit1 ( c -- )  cbuf @ c!  cbuf @ 1 lit ssay ;

\ ── the line ──────────────────────────────────────────────────────────────────
: nextc ( -- c )
	begin rpos @ rlen @ u< 0= while
		"0" 1 lit rbuf @ 80 lit sget dup 0< if drop 0 lit then rlen !  0 lit rpos !
	repeat
	rbuf @ rpos @ + c@  rpos @ 1 lit + rpos ! ;
: hbuf variable ;  : hn variable ;  : hpos variable ;  : lesc variable ;     \ the history: 16 lines of 0x200 (+0 length, +4 the bytes), how many, the recall position; an escape sequence under way
: hent ( i -- a )  9 lit lshift hbuf @ + ;
: lsame ( a b n -- flag )  -1 lit swap 0 lit do 2 lit pick i + c@ 2 lit pick i + c@ <> if drop 0 lit then loop nip nip ;
: lerase ( -- )  llen @ ?dup if 0 lit do 8 lit emit1 20 lit emit1 8 lit emit1 loop then  0 lit llen ! ;
: lset ( a n -- )  lerase  dup llen !  lbuf @ swap mcopy  lbuf @ llen @ ssay ;
: hrecall ( d -- )                                 \ d: -1 the older line, 1 the newer; past the newest the line is empty
	hpos @ + dup 0< over hn @ u> or if drop else
		dup hpos !  dup hn @ = if drop lerase else hent dup 4 lit + swap @ lset then
	then ;
: hpush ( -- )                                     \ the line into the history, unless it repeats the last
	llen @ if
		hn @ if hn @ 1 lit - hent dup @ llen @ = if 4 lit + lbuf @ llen @ lsame else drop 0 lit then else 0 lit then 0= if
			hn @ 10 lit = if 1 lit hent 0 lit hent 1E00 lit mcopy  F lit hn ! then
			llen @ hn @ hent !  lbuf @ hn @ hent 4 lit + llen @ mcopy  hn @ 1 lit + hn !
		then
	then ;
: sexit ( -- )  "2" 1 lit obuf @ 40 lit sget 0 lit u> if texit else shalt then ;   \ in a terminal the shell ends (the window closes); on the console the node halts
: lchar ( c -- )
	lesc @ 1 lit = if '[' lit = if 2 lit lesc ! else 0 lit lesc ! then else
	lesc @ 2 lit = if
		dup '0' lit - A lit u< if drop else                                      \ a parameter: the final is still to come
		dup 'A' lit = if -1 lit hrecall else dup 'B' lit = if 1 lit hrecall then then drop  0 lit lesc ! then
	else
	dup 1B lit = if drop 1 lit lesc ! else
	dup 4 lit = if drop llen @ 0= if A lit emit1 sexit then else                 \ Ctrl-D on an empty line: exit
	dup 15 lit = if drop lerase else                                             \ Ctrl-U: the line erased
	dup 3 lit = if drop "^C" say A lit emit1  0 lit llen !  -1 lit ldone ! else  \ Ctrl-C: the line abandoned
	dup D lit = over A lit = or if drop -1 lit ldone !  A lit emit1 else
	dup 7F lit = over 8 lit = or if drop llen @ if llen @ 1 lit - llen !  8 lit emit1 20 lit emit1 8 lit emit1 then else
	llen @ 1FF lit u< if dup lbuf @ llen @ + c!  llen @ 1 lit + llen !  emit1 else drop then
	then then then then then then then then ;
: getline ( -- )  0 lit llen !  0 lit ldone !  0 lit lesc !  hn @ hpos !  begin nextc lchar ldone @ until ;

\ ── paths ─────────────────────────────────────────────────────────────────────
\ pnorm ( a n -- )  the path, absolute or relative to the working directory,
\ with "." and ".." resolved, as "/x/y" in pbuf (plen bytes)
: ppop ( -- )  plen @ 1 lit u> if begin plen @ 1 lit - plen !  pbuf @ plen @ + c@ '/' lit =  plen @ 1 lit = or until then ;
: papp ( a n -- )
	plen @ 1 lit u> if '/' lit pbuf @ plen @ + c!  plen @ 1 lit + plen ! then
	dup plen @ + 1FF lit u> if 2drop else over pbuf @ plen @ + 2 lit pick mcopy  plen @ + plen !  drop then ;
: pcomp ( -- )
	ca @ cs @ - ?dup if
		dup 1 lit = cs @ c@ '.' lit = and if drop else
		dup 2 lit = cs @ c@ '.' lit = and cs @ 1 lit + c@ '.' lit = and if drop ppop else
		cs @ swap papp then then
	then ;
: pnorm
	dup if over c@ '/' lit = else 0 lit then if
		1 lit plen !  '/' lit pbuf @ c!
	else
		pbuf @ 200 lit spwd dup 0< if drop 1 lit '/' lit pbuf @ c! then plen !
	then
	over + ce !  dup ca ! cs !
	begin ca @ ce @ u< while
		ca @ c@ '/' lit = if pcomp  ca @ 1 lit + dup ca ! cs ! else ca @ 1 lit + ca ! then
	repeat pcomp ;

\ ── ls ────────────────────────────────────────────────────────────────────────
: lspre? ( -- flag )  lskl @ lsl @ u< if 0 lit else -1 lit lsl @ ?dup if 0 lit do lsk @ i + c@ pbuf @ 1 lit + i + c@ <> if drop 0 lit then loop then then ;
: ls ( a n -- )
	dup 0= if 2drop "." 1 lit then pnorm
	plen @ 1 lit - lsl !  lsl @ if '/' lit pbuf @ plen @ + c!  lsl @ 1 lit + lsl ! then     \ the tree's prefix: "x/y/" or ""
	'/' lit sbuf @ c!  pbuf @ 1 lit + sbuf @ 1 lit + lsl @ mcopy  lsl @ 1 lit + sln !  -1 lit lsgo !     \ the start is absolute: the kernel resolves it too
	begin lsgo @ while
		sbuf @ sln @ obuf @ 800 lit sscan 0 lit u> 0= if 0 lit lsgo ! else
			obuf @ @ lskl !  obuf @ 8 lit + lsk !
			lspre? 0= if 0 lit lsgo ! else
				lsl @ begin dup lskl @ u< if dup lsk @ + c@ '/' lit <> else 0 lit then while 1 lit + repeat lsi !
				lsi @ lskl @ u< if
					lsk @ lsl @ + lsi @ lsl @ - ssay  "/\n" say
					lsk @ sbuf @ 1 lit + lsi @ mcopy  '0' lit sbuf @ 1 lit + lsi @ + c!  lsi @ 2 lit + sln !     \ past everything beneath
				else
					lsi @ lsl @ u> if lsk @ lsl @ + lsi @ lsl @ - ssay  "\n" say then                           \ (the directory's own marker is not an entry)
					lsk @ sbuf @ 1 lit + lskl @ mcopy  0 lit sbuf @ 1 lit + lskl @ + c!  lskl @ 2 lit + sln !     \ the next key
				then
			then
		then
	repeat ;

\ ── commands ──────────────────────────────────────────────────────────────────
: rgk variable ;  : rgl variable ;  : rapp variable ;  : rbl variable ;
: rik variable ;  : ril variable ;  : rin variable ;  : rkend variable ;  : rcut variable ;  : ril2 variable ;
\ run ( name n -- )  exec the program (bin/NAME) with the line as its arguments and
\ wait for it.  "> KEY" sends its output to KEY (emptied first), ">> KEY" adds to
\ it, "< KEY" gives it KEY as its input, read from the start as a file: the
\ shell's bindings are set for the child to inherit and put back after.
: rdir ( i -- )                                   \ the redirection at i: its key
	dup lbuf @ + c@ '<' lit = rin !
	dup lbuf @ + 1 lit + c@ '>' lit = dup rapp ! if 2 lit + else 1 lit + then
	begin dup llen @ u< if dup lbuf @ + c@ 20 lit = else 0 lit then while 1 lit + repeat
	dup begin dup llen @ u< if dup lbuf @ + c@ 20 lit <> else 0 lit then while 1 lit + repeat
	dup rkend !  over -  swap lbuf @ + swap  dup 0= if 2drop else rin @ if ril ! rik ! else rgl ! rgk ! then then ;
: redir? ( -- )                                   \ rgk/rgl the output key (0 none), rik/ril the input; the line cut before the first
	0 lit rgk !  0 lit rik !  0 lit rkend !  llen @ rcut !
	llen @ 3 lit u> if llen @ 2 lit - 1 lit do
		i rkend @ u< 0=  lbuf @ i + c@ dup '>' lit = swap '<' lit = or and  lbuf @ i 1 lit - + c@ 20 lit = and if
			rcut @ llen @ = if i 1 lit - rcut ! then  i rdir
		then
	loop then
	rcut @ llen ! ;
: rsl variable ;
: hasl? ( a n -- flag )  0 lit rsl !  ?dup if 0 lit do dup i + c@ '/' lit = if -1 lit rsl ! then loop then drop  rsl @ ;
: run
	redir?
	lbuf @ llen @ sargs! drop
	'/' lit obuf @ 40 lit + c!  "1" 1 lit obuf @ 41 lit + 3F lit sget dup 0< if drop -1 lit then 1 lit + rbl !   \ the bindings as they are (made absolute),
	"1" 1 lit obuf @ 40 lit + rbl @ sput drop                                        \ the output put back now: that flushes the echo before the program's output
	'/' lit obuf @ 80 lit + c!  "2" 1 lit obuf @ 81 lit + 3F lit sget dup 0< if drop -1 lit then 1 lit + ril2 !
	rgk @ if
		rapp @ 0= if rgk @ rgl @ sdel drop then
		"1" 1 lit rgk @ rgl @ sput drop
	then
	rik @ if rik @ ril @ srewind drop  "2" 1 lit rik @ ril @ sput drop then
	2dup hasl? if pnorm pbuf @ plen @ then                                          \ a path (./t.bin, ../bin/x, /bin/x) resolved as cd does; a bare name is bin's
	800000 lit 5 lit sexec
	rgk @ if "1" 1 lit obuf @ 40 lit + rbl @ sput drop then                        \ and back
	rik @ if "2" 1 lit obuf @ 80 lit + ril2 @ sput drop then
	lbuf @ 0 lit sargs! drop
	?dup 0= if "sh: no such program\n" say else
		begin 14 lit msleep dup tstate 0= until
		texcode if "sh: it was killed\n" say then
	then ;
: cmd ( -- )
	lbuf @ kva !  llen @ kvl !  kvtok
	2dup "pwd" kveq if 2drop pbuf @ 200 lit spwd dup 0< if drop 0 lit then pbuf @ swap ssay "\n" say else
	2dup "cd" kveq if 2drop kva @ kvl @ dup 0= if 2drop "/" 1 lit then pnorm  pbuf @ plen @ scd if "sh: cd: refused\n" say then else
	2dup "ls" kveq if 2drop kva @ kvl @ ls else
	2dup "exit" kveq if 2drop sexit else
	2dup "set" kveq 2 lit pick 2 lit pick "get" kveq or 2 lit pick 2 lit pick "add" kveq or 2 lit pick 2 lit pick "del" kveq or 2 lit pick 2 lit pick "list" kveq or if
		2drop lbuf @ llen @ obuf @ 800 lit kvcmd obuf @ swap ssay "\n" say else
	run then then then then then ;

400 lit alloc lbuf !  80 lit alloc rbuf !  0 lit rpos !  0 lit rlen !  800 lit alloc obuf !  4 lit alloc cbuf !
400 lit alloc pbuf !  400 lit alloc sbuf !  2000 lit alloc hbuf !  0 lit hn !
-1 lit kvinit
begin
	pbuf @ 200 lit spwd dup 0< if drop 0 lit then pbuf @ swap ssay  "$ " say
	getline  llen @ if hpush cmd then
0 lit until
