\ prog/sh.fam — a shell on the console.  A line at a time from handle "0",
\ echoed as it is typed (backspace works): pwd, cd [DIR], ls [DIR], the store's
\ commands (set, get, add, del, list: lib/pkv.fam), or a program's name, which
\ is exec'd (bin/NAME) and waited for.  The working directory is the kernel's
\ "." (lib/sys.fam spwd/scd): the shell resolves ".", ".." and relative names
\ against it, the kernel only joins.  ls lists one level: a name with "/" after
\ it has more beneath, and the walk skips what is beneath by seeking past it.
\ Its output goes through handle 0, so it can be redirected like a program's.
: lbuf variable ;  : llen variable ;  : ldone variable ;          \ the line
: rbuf variable ;  : rpos variable ;  : rlen variable ;           \ what the console gave
: obuf variable ;  : cbuf variable ;                              \ answers and scans; a byte
: pbuf variable ;  : plen variable ;                              \ a path being built
: sbuf variable ;  : sln variable ;                               \ a scan's start key
: ca variable ;  : ce variable ;  : cs variable ;                 \ a path's cursor, end, component
: lsl variable ;  : lsk variable ;  : lskl variable ;  : lsi variable ;  : lsgo variable ;

: ssay ( a n -- )  sd ! sc !  "0" 1 lit sc @ sd @ sput drop ;
: emit1 ( c -- )  cbuf @ c!  cbuf @ 1 lit ssay ;

\ ── the line ──────────────────────────────────────────────────────────────────
: nextc ( -- c )
	begin rpos @ rlen @ u< 0= while
		"0" 1 lit rbuf @ 80 lit sget dup 0< if drop 0 lit then rlen !  0 lit rpos !
	repeat
	rbuf @ rpos @ + c@  rpos @ 1 lit + rpos ! ;
: lchar ( c -- )
	dup D lit = over A lit = or if drop -1 lit ldone !  A lit emit1 else
	dup 7F lit = over 8 lit = or if drop llen @ if llen @ 1 lit - llen !  8 lit emit1 20 lit emit1 8 lit emit1 then else
	llen @ 1FF lit u< if dup lbuf @ llen @ + c!  llen @ 1 lit + llen !  emit1 else drop then
	then then ;
: getline ( -- )  0 lit llen !  0 lit ldone !  begin nextc lchar ldone @ until ;

\ ── paths ─────────────────────────────────────────────────────────────────────
\ pnorm ( a n -- )  the path, absolute or relative to the working directory,
\ with "." and ".." resolved, as "/x/y" in pbuf (plen bytes)
: ppop ( -- )  plen @ 1 lit u> if begin plen @ 1 lit - plen !  pbuf @ plen @ + c@ '/' lit =  plen @ 1 lit = or until then ;
: papp ( a n -- )
	plen @ 1 lit u> if '/' lit pbuf @ plen @ + c!  plen @ 1 lit + plen ! then
	dup plen @ + 1FF lit u> if 2drop else over pbuf @ plen @ + 2 lit pick mcopy  plen @ + plen !  drop then ;
: pcomp ( -- )
	ca @ cs @ - ?dup if
		dup 1 lit = cs @ c@ '.' lit = and if drop else
		dup 2 lit = cs @ c@ '.' lit = and cs @ 1 lit + c@ '.' lit = and if drop ppop else
		cs @ swap papp then then
	then ;
: pnorm
	dup if over c@ '/' lit = else 0 lit then if
		1 lit plen !  '/' lit pbuf @ c!
	else
		pbuf @ 200 lit spwd dup 0< if drop 1 lit '/' lit pbuf @ c! then plen !
	then
	over + ce !  dup ca ! cs !
	begin ca @ ce @ u< while
		ca @ c@ '/' lit = if pcomp  ca @ 1 lit + dup ca ! cs ! else ca @ 1 lit + ca ! then
	repeat pcomp ;

\ ── ls ────────────────────────────────────────────────────────────────────────
: lspre? ( -- flag )  lskl @ lsl @ u< if 0 lit else -1 lit lsl @ ?dup if 0 lit do lsk @ i + c@ pbuf @ 1 lit + i + c@ <> if drop 0 lit then loop then then ;
: ls ( a n -- )
	dup 0= if 2drop "." 1 lit then pnorm
	plen @ 1 lit - lsl !  lsl @ if '/' lit pbuf @ plen @ + c!  lsl @ 1 lit + lsl ! then     \ the tree's prefix: "x/y/" or ""
	'/' lit sbuf @ c!  pbuf @ 1 lit + sbuf @ 1 lit + lsl @ mcopy  lsl @ 1 lit + sln !  -1 lit lsgo !     \ the start is absolute: the kernel resolves it too
	begin lsgo @ while
		sbuf @ sln @ obuf @ 800 lit sscan 0 lit u> 0= if 0 lit lsgo ! else
			obuf @ @ lskl !  obuf @ 8 lit + lsk !
			lspre? 0= if 0 lit lsgo ! else
				lsl @ begin dup lskl @ u< if dup lsk @ + c@ '/' lit <> else 0 lit then while 1 lit + repeat lsi !
				lsk @ lsl @ + lsi @ lsl @ - ssay
				lsi @ lskl @ u< if
					"/\n" say  lsk @ sbuf @ 1 lit + lsi @ mcopy  '0' lit sbuf @ 1 lit + lsi @ + c!  lsi @ 2 lit + sln !     \ past everything beneath
				else
					"\n" say  lsk @ sbuf @ 1 lit + lskl @ mcopy  0 lit sbuf @ 1 lit + lskl @ + c!  lskl @ 2 lit + sln !     \ the next key
				then
			then
		then
	repeat ;

\ ── commands ──────────────────────────────────────────────────────────────────
: run ( name n -- )
	800000 lit 5 lit sexec ?dup 0= if "sh: no such program\n" say else
		begin 14 lit msleep dup tstate 0= until
		texcode if "sh: it was killed\n" say then
	then ;
: cmd ( -- )
	lbuf @ kva !  llen @ kvl !  kvtok
	2dup "pwd" kveq if 2drop pbuf @ 200 lit spwd dup 0< if drop 0 lit then pbuf @ swap ssay "\n" say else
	2dup "cd" kveq if 2drop kva @ kvl @ dup 0= if 2drop "/" 1 lit then pnorm  pbuf @ plen @ scd if "sh: cd: refused\n" say then else
	2dup "ls" kveq if 2drop kva @ kvl @ ls else
	2dup "set" kveq 2 lit pick 2 lit pick "get" kveq or 2 lit pick 2 lit pick "add" kveq or 2 lit pick 2 lit pick "del" kveq or 2 lit pick 2 lit pick "list" kveq or if
		2drop lbuf @ llen @ obuf @ 800 lit kvcmd obuf @ swap ssay "\n" say else
	run then then then then ;

400 lit alloc lbuf !  80 lit alloc rbuf !  0 lit rpos !  0 lit rlen !  800 lit alloc obuf !  4 lit alloc cbuf !
400 lit alloc pbuf !  400 lit alloc sbuf !
-1 lit kvinit
"sh: a shell on the console: pwd, cd, ls, set, get, add, del, list, or a program's name\n" say
begin
	pbuf @ 200 lit spwd dup 0< if drop 0 lit then pbuf @ swap ssay  "$ " say
	getline  llen @ if cmd then
0 lit until
