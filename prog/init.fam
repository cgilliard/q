\ prog/init.fam — the first program the node runs.  It execs what the keys under
\ /init.d/ name: each one's value is the path of a program (a link, as
\ /init.d/wm = /bin/wm), run in 8 MiB with 5 tickets.  Then it watches them:
\ one the kernel killed is restarted, up to three times; one that exited stays
\ down; when none is left init exits too.  Up to 8 entries.
: ibuf variable ;  : ich variable ;  : inn variable ;  : isb variable ;  : isn variable ;  : igo variable ;
: ik variable ;  : ikl variable ;  : iv variable ;  : ivl variable ;
: irec ( i -- rec )  7 lit lshift ich @ + ;        \ +0 tid  +4 restarts  +8 name length  +C name (0-ended)  +40 path length  +44 path
: iumin ( a b -- min )  2dup u> if swap then drop ;
: isame ( a b n -- flag )  -1 lit swap 0 lit do 2 lit pick i + c@ 2 lit pick i + c@ <> if drop 0 lit then loop nip nip ;

: istart ( i -- )
	irec dup 44 lit + over 40 lit + @ 800000 lit 5 lit sexec
	dup 0= if "init: could not start " say over C lit + say "\n" say then
	swap ! ;

\ iscan ( -- )  the entries under /init.d/, in order, into the records
: iscan
	"/init.d/" isb @ 8 lit mcopy  8 lit isn !  0 lit inn !  -1 lit igo !
	begin igo @ inn @ 8 lit u< and while
		isb @ isn @ ibuf @ 400 lit sscan 0 lit u> 0= if 0 lit igo ! else
			ibuf @ @ ikl !  ibuf @ 8 lit + ik !  ibuf @ 4 lit + @ ivl !  ik @ ikl @ 3 lit + FFFFFFFC lit and + iv !
			ikl @ 7 lit u> if ik @ "init.d/" 7 lit isame else 0 lit then 0= if 0 lit igo ! else
				ikl @ 7 lit - 2F lit iumin dup inn @ irec 8 lit + !  ik @ 7 lit + inn @ irec C lit + 2 lit pick mcopy  0 lit inn @ irec C lit + rot + c!
				ivl @ 3B lit iumin dup inn @ irec 40 lit + !  iv @ inn @ irec 44 lit + rot mcopy
				0 lit inn @ irec !  0 lit inn @ irec 4 lit + !
				inn @ 1 lit + inn !
				'/' lit isb @ c!  ik @ isb @ 1 lit + ikl @ mcopy  0 lit isb @ ikl @ 1 lit + + c!  ikl @ 2 lit + isn !     \ on from this key
			then
		then
	repeat ;

400 lit alloc ibuf !  400 lit alloc ich !  220 lit alloc isb !
iscan
inn @ 0= if "init: nothing under /init.d/: nothing to run\n" say texit then
inn @ 0 lit do i istart loop
begin
	64 lit msleep
	0 lit inn @ 0 lit do
		i irec @ if
			i irec @ tstate 0= if
				i irec @ texcode if
					i irec 4 lit + @ 3 lit u< if
						"init: " say i irec C lit + say " was killed: restarting it\n" say
						i irec 4 lit + dup @ 1 lit + swap !  i istart
					else "init: " say i irec C lit + say " keeps getting killed: giving up on it\n" say 0 lit i irec ! then
				else "init: " say i irec C lit + say " exited\n" say 0 lit i irec ! then
			then
		then
		i irec @ if 1 lit + then
	loop
0= until
"init: nothing left to run\n" say
