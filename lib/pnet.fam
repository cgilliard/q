\ ──────────────────────────────────────────────────────────────────────────────
\ lib/pnet.fam — a program's NIC: the frames for the ports it holds, delivered
\ by the kernel into a ring in the program's memory (src/ports.fam), and frames
\ out as requests.  Gives src/eth.fam, src/ip.fam and src/udp.fam the driver
\ words they use (src/net.fam's), so they build into a program unchanged.
\
\   pnetinit ( slots -- )        the receive ring, slots x 0x604 bytes from the
\                                heap, and a 256-slot transmit ring the loop
\                                thread drains (no request per frame out)
\   pbind    ( proto port -- r ) hold a port: 0, -1 taken, -2 bad ring, -3 no room
\   punbind  ( proto port -- )
\   netinfo  ( -- )              the node's addresses from the kernel into pinfo:
\                                +0 ip +4 mask +8 gateway +C its MAC +12 ours
\   netrx ( -- buf len -1 | 0 )  netrel ( -- )  nettx ( buf len -- ok )
\   netmac ( -- addr )  nbit ( -- mask: bit 18 )  narm ( -- )
\   nzero ( addr nwords -- )     src/net.fam's
\ Needs lib/sys.fam.
\ ──────────────────────────────────────────────────────────────────────────────


: pring variable ;  : prsz variable ;  : pinfo variable ;  : ptxr variable ;
\ pmkring ( slots -- ring bytes )
: pmkring
	dup 604 lit * 10 lit + dup alloc                                 \ slots bytes ring
	dup 2 lit pick 2 lit rshift 0 lit do 0 lit over i 2 lit lshift + ! loop drop
	rot over !  604 lit over C lit + !  swap ;
: pnetinit ( slots -- )
	pmkring prsz ! pring !
	100 lit pmkring over ptxr !  8 lit -rot 0 lit 0 lit kreq drop  \ registered with the kernel
	18 lit alloc pinfo ! ;
: pbind   ( proto port -- r )  6 lit -rot pring @ prsz @ kreq ;
: punbind ( proto port -- )    7 lit -rot 0 lit 0 lit kreq drop ;
: netinfo ( -- )  9 lit pinfo @ 0 lit 0 lit 0 lit kreq drop ;
: netmac  ( -- addr )  pinfo @ 12 lit + ;
: nbit    ( -- mask )  40000 lit ;
: narm    ( -- ) ;
: netrx   ( -- buf len -1 | 0 )
	pring @ 4 lit + @ pring @ 8 lit + @ = if 0 lit else
		pring @ 4 lit + @ pring @ @ 1 lit - and pring @ C lit + @ * pring @ + 10 lit +
		dup 4 lit + swap @ -1 lit
	then ;
: netrel  ( -- )  pring @ 4 lit + dup @ 1 lit + swap ! ;
\ ptxfull ( -- flag )  the transmit ring is full; while it is, the loop thread is
\ posted and given the CPU up to 64 times so it can drain it (a burst of answers
\ is then not lost on the ring)
: ptxfull
	0 lit begin ptxr @ 8 lit + @ ptxr @ 4 lit + @ - ptxr @ @ u< 0=  over 40 lit u<  and while
		80000 lit 0 lit post yield 1 lit +
	repeat drop
	ptxr @ 8 lit + @ ptxr @ 4 lit + @ - ptxr @ @ u< 0= ;
: nettx   ( buf len -- ok )
	ptxfull if 2drop 0 lit else
		ptxr @ 8 lit + @ ptxr @ @ 1 lit - and ptxr @ C lit + @ * ptxr @ + 10 lit +     \ buf len slot
		2 lit pick over 4 lit + 3 lit pick mcopy  ! drop
		ptxr @ 8 lit + @ ptxr @ 4 lit + @ =                              \ was it empty? then the loop thread is not yet told
		ptxr @ 8 lit + dup @ 1 lit + swap !
		if 80000 lit 0 lit post then -1 lit
	then ;
