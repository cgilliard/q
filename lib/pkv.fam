\ ──────────────────────────────────────────────────────────────────────────────
\ lib/pkv.fam — prog/kv.fam for a program: the same commands and answers, the
\ store reached through requests (lib/sys.fam) instead of called.  A list is a
\ scan request: at most 20 keys, values cut at 64 bytes.
\
\   kvinit ( open? -- )              once (the flag is kept for the interface)
\   kvcmd  ( in n out cap -- n' )    one command; its answer at out, at most
\                                    cap bytes; n' is the answer's length
\
\ Commands (tokens are separated by one space; a set's value is the rest of
\ the line, spaces and all):
\   set KEY VALUE     kv: KEY = VALUE
\   add KEY VALUE     kv: KEY += N bytes      (appended to the value)
\   get KEY           kv: KEY = VALUE  |  kv: KEY: not found
\   del KEY           kv: KEY: deleted  |  kv: KEY: not found
\   list [PREFIX]     kv: list PREFIX, a line per key in order (at most 20,
\                     each value cut at 64 bytes), then the count
\ Every answer starts with "kv: ", which is how the page tells them from the
\ echoes.  A set or del is one write transaction, committed (on the disk)
\ before the answer; a get or list is one read transaction.  Answers are cut
\ at cap.  Needs src/store.fam (and what it needs).
\ ──────────────────────────────────────────────────────────────────────────────

: kvok variable ;                                       \ is there a store
: kvo variable ;  : kvc variable ;  : kvp variable ;    \ the answer: start, cap, cursor
: kva variable ;  : kvl variable ;                      \ the rest of the command
: kvk variable ;  : kvkl variable ;  : kvvl variable ;  \ the key, the value's length
: kvb variable ;  : kvt variable ;  : kvu variable ;  : kvm variable ;   \ scratch, transaction, cursor, count

: umin ( a b -- min )  2dup u> if swap then drop ;
: kvinit ( open? -- )  kvok !  kvb @ 0= if 810 lit alloc kvb ! then ;

\ ── the answer ────────────────────────────────────────────────────────────────
: kvroom ( -- n )  kvo @ kvc @ + kvp @ - ;
: kvn+ ( a n -- )  kvroom umin  over kvp @ 2 lit pick mcopy  kvp @ + kvp !  drop ;
: kv+ ( s -- )  dup begin dup c@ while 1 lit + repeat over - kvn+ ;
: kvd+ ( n -- )                                         \ in decimal (the digits grow down from the scratch's end)
	kvb @ 810 lit +
	begin 1 lit - over A lit % '0' lit + over c!  swap A lit / swap  over 0= until
	nip dup kvb @ 810 lit + swap - kvn+ ;

\ ── the command ───────────────────────────────────────────────────────────────
\ kvsp ( a n -- i )  the index of the first space, or n
: kvsp  0 lit begin 2dup u> if 2 lit pick over + c@ 20 lit <> else 0 lit then while 1 lit + repeat nip nip ;
\ kvtok ( -- tok tl )  the next token; the rest of the command starts after the space
: kvtok
	kva @ kvl @ kvsp  kva @ over
	rot dup kvl @ u< if 1 lit + then
	dup kva @ + kva !  kvl @ swap - kvl ! ;
\ kveq ( tok tl s -- flag )  is the token this string
: kveq
	dup begin dup c@ while 1 lit + repeat over -
	2 lit pick <> if 2drop drop 0 lit else
		-1 lit 2 lit pick 0 lit do 3 lit pick i + c@ 2 lit pick i + c@ <> if drop 0 lit then loop nip nip nip then ;
\ kvkey ( -- flag )  the command's key into kvk/kvkl; 0 with the complaint written
: kvkey
	kvtok kvkl ! kvk !
	kvkl @ 0= if "kv: a key is needed" kv+ 0 lit else
	kvkl @ 1FF lit u> if "kv: the key is over 511 bytes" kv+ 0 lit else -1 lit then then ;

: kvset
	kvkey if
		kvk @ kvkl @ kva @ kvl @ sput drop
		"kv: " kv+ kvk @ kvkl @ kvn+ " = " kv+ kva @ kvl @ kvn+
	then ;
: kvadd
	kvkey if
		kvk @ kvkl @ kva @ kvl @ sadd drop
		"kv: " kv+ kvk @ kvkl @ kvn+ " += " kv+ kvl @ kvd+ " bytes" kv+
	then ;
: kvget
	kvkey if
		kvk @ kvkl @ kvb @ 800 lit sget kvvl !
		"kv: " kv+ kvk @ kvkl @ kvn+
		kvvl @ 0< if ": not found" kv+ else " = " kv+ kvb @ kvvl @ 800 lit umin kvn+ then
	then ;
: kvdel
	kvkey if
		kvk @ kvkl @ sdel
		"kv: " kv+ kvk @ kvkl @ kvn+ if ": deleted" kv+ else ": not found" kv+ then
	then ;

\ kvrec+ ( rec -- rec' )  one scan record as a line
: kvrec+
	"\n" kv+
	dup 8 lit + over @ kvn+  " = " kv+
	dup 8 lit + over @ 3 lit + FFFFFFFC lit and + over 4 lit + @ 40 lit umin kvn+
	dup 4 lit + @ 40 lit u> if "..." kv+ then
	dup @ 3 lit + FFFFFFFC lit and over 4 lit + @ 40 lit umin 3 lit + FFFFFFFC lit and + 8 lit + + ;
: kvlist
	kvtok kvkl ! kvk !
	kvkl @ 1FF lit u> if "kv: the prefix is over 511 bytes" kv+ else
		"kv: list " kv+ kvk @ kvkl @ kvn+
		kvk @ kvkl @ kvb @ 800 lit sscan dup kvm !
		kvb @ swap ?dup if 0 lit do kvrec+ loop then drop
		"\n" kv+ kvm @ kvd+ " key(s)" kv+  kvm @ 14 lit = if ", more may follow" kv+ then
	then ;

: kvcmd ( in n out cap -- n' )
	kvc !  dup kvo ! kvp !  kvl ! kva !
	kvtok
	kvok @ 0= if 2drop "kv: no store (the node has no disk)" kv+ else
	2dup "set" kveq if 2drop kvset else
	2dup "add" kveq if 2drop kvadd else
	2dup "get" kveq if 2drop kvget else
	2dup "del" kveq if 2drop kvdel else
	2dup "list" kveq if 2drop kvlist else
	2drop "kv: usage: set KEY VALUE | add KEY VALUE | get KEY | del KEY | list [PREFIX]" kv+
	then then then then then then
	kvp @ kvo @ - ;

